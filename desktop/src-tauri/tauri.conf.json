{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FIFA 14 Patch Studio",
  "mainBinaryName": "fifa14-patch-studio",
  "version": "0.1.0",
  "identifier": "com.sajermann.fifa14patchstudio",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Bruno Sajermann",
    "copyright": "GPL-3.0",
    "category": "Utility",
    "shortDescription": "FIFA 14 Patch Studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend/dist/f14-backend/": "backend/",
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}